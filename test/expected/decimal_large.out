-- Check whether external tape sort can handle large data or not
-- Test decimal data type with huge date 1.5 million rows 
DROP TABLE IF EXISTS decimal_large_data;
NOTICE:  table "decimal_large_data" does not exist, skipping
CREATE TABLE decimal_large_data (
    id DECIMAL(10, 2)
);
DO $$
DECLARE
    i DECIMAL := 1;
BEGIN
    FOR i IN 1..1500000 LOOP
        INSERT INTO decimal_large_data(id) VALUES (i);
    END LOOP;
END $$;
SELECT COUNT(id) FROM decimal_large_data;
  count  
---------
 1500000
(1 row)

SELECT median(id) FROM decimal_large_data;
       median        
---------------------
 750000.500000000000
(1 row)

