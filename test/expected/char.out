(1 row)

SELECT * FROM char_table_even ORDER BY id;
     id     
------------
 Jerry     
 Mickey    
 Minnie    
 Tom       
(4 rows)

SELECT median(id) AS median_value FROM char_table_even;
 median_value 
--------------
 Mickey    
(1 row)

-- 5. bpchar (variable unlimited length, blank-trimmed)
SELECT * FROM bpchar_table_odd ORDER BY id;
   id   
--------
